{
  "name": "@hogancv/coordinate-agents",
  "version": "2.1.1",
  "description": "A local-first coordination protocol and runtime for AI coding agents.",
  "type": "module",
  "bin": {
    "coordinate-agents": "bin/coordinate-agents.mjs"
  },
  "files": [
    "adapters",
    "agents",
    "bin",
    "references",
    "scripts",
    "SKILL.md",
    "AI_INSTALL.md",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "llms.txt",
    "docs/llms.txt",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "test": "node --test",
    "sync:llms": "node scripts/sync-llms.mjs",
    "check:llms": "node scripts/sync-llms.mjs --check",
    "check": "node bin/coordinate-agents.mjs --help && npm run check:llms && npm test",
    "prepack": "npm run sync:llms && npm run check",
    "demo": "node scripts/demo.mjs",
    "release:check": "npm ci && npm run check && npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hogancv/coordinate-agents.git"
  },
  "homepage": "https://github.com/hogancv/coordinate-agents#readme",
  "bugs": {
    "url": "https://github.com/hogancv/coordinate-agents/issues"
  },
  "keywords": [
    "agent",
    "ai-agents",
    "multi-agent",
    "coordination",
    "protocol",
    "runtime",
    "adapters",
    "codex",
    "codex-cli",
    "antigravity",
    "agy",
    "multi-agent-collaboration",
    "specification",
    "implementation",
    "code-review",
    "release-gate",
    "recovery",
    "skill"
  ],
  "author": "hogancv",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
