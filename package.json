{
  "name": "@hogancv/coordinate-agents",
  "version": "2.3.0",
  "description": "A local-first coordination protocol, plugin, and runtime for AI coding agents.",
  "type": "module",
  "exports": {
    "./adapter-sdk": "./adapter-sdk.mjs",
    "./adapter-sdk.mjs": "./adapter-sdk.mjs",
    "./*": "./*"
  },
  "bin": {
    "coordinate-agents": "bin/coordinate-agents.mjs"
  },
  "files": [
    "adapter-sdk.mjs",
    ".codex-plugin",
    ".mcp.json",
    ".agents",
    "skills",
    "mcp",
    "schemas",
    "bin",
    "inspector",
    "scripts",
    "AI_INSTALL.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "llms.txt",
    "docs/llms.txt",
    "docs/adapter-conformance.md",
    "docs/adapter-author-guide.md",
    "docs/mcp.md",
    "docs/MCP_TROUBLESHOOTING.md",
    "docs/inspector.md",
    "docs/event-journal.md",
    "docs/session-runtime.md",
    "docs/task-graph-v1.md",
    "LICENSE",
    "assets",
    "examples"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "sync:llms": "node scripts/sync-llms.mjs",
    "check:llms": "node scripts/sync-llms.mjs --check",
    "check": "node bin/coordinate-agents.mjs --help && npm run check:llms && npm test",
    "prepack": "npm run sync:llms && npm run check",
    "demo": "node scripts/demo.mjs",
    "mcp:self-test": "node mcp/self-test.mjs",
    "release:check": "npm ci && npm run check && npm pack --dry-run",
    "release:verify": "node scripts/verify-release-artifact.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hogancv/coordinate-agents.git"
  },
  "homepage": "https://github.com/hogancv/coordinate-agents#readme",
  "bugs": {
    "url": "https://github.com/hogancv/coordinate-agents/issues"
  },
  "keywords": [
    "agent",
    "ai-agents",
    "multi-agent",
    "coordination",
    "protocol",
    "runtime",
    "adapters",
    "codex",
    "codex-cli",
    "antigravity",
    "agy",
    "multi-agent-collaboration",
    "specification",
    "implementation",
    "code-review",
    "release-gate",
    "recovery",
    "skill"
  ],
  "author": "hogancv",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "node-pty": "1.1.0"
  }
}
