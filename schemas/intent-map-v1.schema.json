{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hogancv/coordinate-agents/schemas/intent-map-v1.schema.json",
  "title": "Coordinate Agents Intent Map v1",
  "type": "object",
  "required": ["schemaVersion", "parentTaskId", "subtasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "parentTaskId": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
    "scopePolicy": { "type": "string", "enum": ["observe", "warn", "strict"], "default": "warn" },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "writeIntent"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "writeIntent": {
            "type": "array",
            "maxItems": 4096,
            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
