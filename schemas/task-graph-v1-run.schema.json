{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hogancv/coordinate-agents/schemas/task-graph-v1-run.schema.json",
  "title": "Coordinate Agents Task Graph v1 parallel run result",
  "type": "object",
  "required": ["ok", "command", "root", "graphId", "parentTaskId", "baseCommit", "selected", "initialPlan", "outcomes", "summary", "graph", "frontier"],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "task.graph-run" },
    "root": { "type": "string", "minLength": 1 },
    "graphId": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
    "parentTaskId": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
    "baseCommit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "selected": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } },
    "initialPlan": { "$ref": "./task-graph-v1-plan.schema.json" },
    "outcomes": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/outcome" } },
    "summary": {
      "type": "object",
      "required": ["selected", "succeeded", "running", "failed"],
      "properties": {
        "selected": { "type": "integer", "minimum": 0, "maximum": 32 },
        "succeeded": { "type": "integer", "minimum": 0, "maximum": 32 },
        "running": { "type": "integer", "minimum": 0, "maximum": 32 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 32 }
      },
      "additionalProperties": false
    },
    "graph": { "$ref": "./task-graph-v1-record.schema.json" },
    "frontier": { "type": "object" }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "required": ["ok", "subtaskId", "state", "evidence"],
      "properties": {
        "ok": { "type": "boolean" },
        "subtaskId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "state": { "type": ["string", "null"], "enum": ["PENDING", "READY", "WAITING", "RUNNING", "SUCCEEDED", "FAILED", "BLOCKED", "STOPPED", null] },
        "worktree": { "type": "object" },
        "session": { "type": "object" },
        "agent": { "type": "object" },
        "implementationCommit": { "type": ["string", "null"] },
        "sessionId": { "type": ["string", "null"] },
        "worktreePath": { "type": ["string", "null"] },
        "error": { "type": "object" },
        "evidence": { "type": "array", "maxItems": 64 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
