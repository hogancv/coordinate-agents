{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hogancv/coordinate-agents/schemas/task-graph-v1-record.schema.json",
  "title": "Coordinate Agents Task Graph v1 durable record",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "parentTaskId",
    "parentTask",
    "state",
    "status",
    "reason",
    "evidence",
    "maxConcurrency",
    "createdAt",
    "updatedAt",
    "subtasks",
    "frontier"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "task-graph" },
    "id": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
    "parentTaskId": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
    "parentTask": { "$ref": "#/$defs/parentTask" },
    "state": { "type": "string", "enum": ["CREATED", "RUNNING", "REVIEWING", "APPROVED", "ERROR", "STOPPED"] },
    "status": { "type": "string", "enum": ["CREATED", "RUNNING", "REVIEWING", "APPROVED", "ERROR", "STOPPED"] },
    "reason": { "type": ["string", "null"], "maxLength": 8192 },
    "evidence": { "type": "array", "maxItems": 64 },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
    "intentMap": { "$ref": "./intent-map-v1.schema.json" },
    "baseCommit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "subtasks": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/subtask" } },
    "frontier": { "$ref": "#/$defs/frontier" },
    "integration": { "anyOf": [{ "$ref": "#/$defs/integration" }, { "type": "null" }] },
    "review": { "anyOf": [{ "$ref": "#/$defs/review" }, { "type": "null" }] },
    "reviewHistory": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/review" } }
  },
  "$defs": {
    "parentTask": {
      "type": "object",
      "required": ["id", "title", "planner", "reviewer", "state", "status", "reason", "evidence", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
        "title": { "type": "string", "minLength": 1 },
        "spec": { "type": "string" },
        "planner": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "implementer": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "reviewer": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "state": { "type": "string" },
        "status": { "type": "string" },
        "reason": { "type": ["string", "null"], "maxLength": 8192 },
        "evidence": { "type": "array", "maxItems": 64 },
        "baseCommit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "subtask": {
      "type": "object",
      "required": ["id", "subtaskId", "parentTaskId", "implementer", "spec", "dependsOn", "state", "status", "reason", "evidence", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "subtaskId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "parentTaskId": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
        "title": { "type": "string", "minLength": 1 },
        "implementer": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "spec": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } },
        "state": { "type": "string", "enum": ["PENDING", "READY", "WAITING", "RUNNING", "SUCCEEDED", "FAILED", "BLOCKED", "STOPPED"] },
        "status": { "type": "string" },
        "reason": { "type": ["string", "null"], "maxLength": 8192 },
        "evidence": { "type": "array", "maxItems": 64 },
        "baseCommit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
        "worktreePath": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "effectiveCommand": { "type": "string", "minLength": 1 },
        "resolvedCommand": { "type": "string", "minLength": 1 },
        "implementationCommit": { "type": "string", "minLength": 1 },
        "lastError": {
          "anyOf": [
            { "type": "object" },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "recovery": { "type": ["object", "null"] },
        "cleanup": { "type": ["object", "null"] },
        "dispatch": { "type": ["object", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "frontier": {
      "type": "object",
      "required": ["ready", "waiting", "blocked", "running", "succeeded", "failed", "stopped", "eligible", "capacityLimited", "maxConcurrency", "runningCount", "availableSlots", "reasons"],
      "properties": {
        "ready": { "type": "array", "items": { "type": "string" } },
        "waiting": { "type": "array", "items": { "type": "string" } },
        "blocked": { "type": "array", "items": { "type": "string" } },
        "running": { "type": "array", "items": { "type": "string" } },
        "succeeded": { "type": "array", "items": { "type": "string" } },
        "failed": { "type": "array", "items": { "type": "string" } },
        "stopped": { "type": "array", "items": { "type": "string" } },
        "eligible": { "type": "array", "items": { "type": "string" } },
        "capacityLimited": { "type": "array", "items": { "type": "string" } },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "runningCount": { "type": "integer", "minimum": 0 },
        "availableSlots": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "required": ["schemaVersion", "kind", "parentTaskId", "state", "status", "createdAt", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "task-graph-integration" },
        "parentTaskId": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
        "state": { "type": "string", "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED"] },
        "status": { "type": "string", "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED"] },
        "reason": { "type": ["string", "null"], "maxLength": 8192 },
        "lastError": {
          "anyOf": [
            { "type": "object" },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "baseCommit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
        "worktreePath": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "worktreeHead": { "type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
        "aggregateCommit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
        "sourceFingerprint": { "type": ["string", "null"] },
        "sourceRefs": { "type": "array", "maxItems": 256, "items": { "type": "object" } },
        "appliedRefs": { "type": "array", "maxItems": 256, "items": { "type": "object" } },
        "appliedCommits": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
        "appliedSubtasks": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
        "conflict": { "type": ["object", "null"] },
        "cleanup": { "type": ["object", "null"] },
        "evidence": { "type": "array", "maxItems": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["schemaVersion", "kind", "decision", "reviewer", "feedback", "decidedAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "task-graph-review" },
        "decision": { "type": "string", "enum": ["REVIEW_APPROVED", "CHANGES_REQUESTED"] },
        "reviewer": { "type": "string" },
        "feedback": { "type": "string", "maxLength": 8192 },
        "integrationCommit": { "type": ["string", "null"] },
        "integrationWorktreePath": { "type": ["string", "null"] },
        "integrationBranch": { "type": ["string", "null"] },
        "integrationRef": { "type": ["string", "null"] },
        "evidence": { "type": "array", "maxItems": 64 },
        "decidedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
