{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hogancv/coordinate-agents/schemas/scope-audit-v1.schema.json",
  "title": "Coordinate Agents Scope Audit v1 evidence",
  "type": "object",
  "required": [
    "schemaVersion", "parentTaskId", "subtaskId", "graphBaseCommit", "implementationCommit",
    "scopePolicy", "coverage", "writeIntent", "actualPathCount", "actualPaths",
    "actualPathsTruncated", "outsideIntentPathCount", "outsideIntentPaths",
    "outsideIntentPathsTruncated", "committedChangeCount", "committedChanges",
    "committedChangesTruncated", "dirtyChangeCount", "dirtyChanges", "dirtyChangesTruncated",
    "dirtyWorktreeAvailable", "hasDirty", "drift", "driftEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "parentTaskId": { "type": "string", "pattern": "^task-[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
    "subtaskId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "graphBaseCommit": { "$ref": "#/$defs/commit" },
    "implementationCommit": { "$ref": "#/$defs/commit" },
    "scopePolicy": { "enum": ["observe", "warn", "strict"] },
    "coverage": { "enum": ["declared", "explicit-empty"] },
    "writeIntent": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "actualPathCount": { "type": "integer", "minimum": 0 },
    "actualPaths": { "$ref": "#/$defs/paths" },
    "actualPathsTruncated": { "type": "boolean" },
    "outsideIntentPathCount": { "type": "integer", "minimum": 0 },
    "outsideIntentPaths": { "$ref": "#/$defs/paths" },
    "outsideIntentPathsTruncated": { "type": "boolean" },
    "committedChangeCount": { "type": "integer", "minimum": 0 },
    "committedChanges": { "$ref": "#/$defs/changes" },
    "committedChangesTruncated": { "type": "boolean" },
    "dirtyChangeCount": { "type": "integer", "minimum": 0 },
    "dirtyChanges": { "$ref": "#/$defs/changes" },
    "dirtyChangesTruncated": { "type": "boolean" },
    "dirtyWorktreeAvailable": { "type": "boolean" },
    "hasDirty": { "type": "boolean" },
    "drift": { "type": "boolean" },
    "driftEvidence": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "outsideIntentPathCount", "outsideIntentPaths", "committedOutsideCount", "committedOutside", "dirtyOutsideCount", "dirtyOutside", "truncated"],
          "properties": {
            "code": { "const": "INTENT_SCOPE_DRIFT" },
            "outsideIntentPathCount": { "type": "integer", "minimum": 1 },
            "outsideIntentPaths": { "$ref": "#/$defs/paths" },
            "committedOutsideCount": { "type": "integer", "minimum": 0 },
            "committedOutside": { "$ref": "#/$defs/changes" },
            "dirtyOutsideCount": { "type": "integer", "minimum": 0 },
            "dirtyOutside": { "$ref": "#/$defs/changes" },
            "truncated": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "paths": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/path" } },
    "change": {
      "type": "object",
      "required": ["status", "path"],
      "properties": {
        "status": { "type": "string", "pattern": "^[A-Z?]{1,2}$" },
        "oldPath": { "$ref": "#/$defs/path" },
        "path": { "$ref": "#/$defs/path" }
      },
      "additionalProperties": false
    },
    "changes": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/change" } }
  },
  "additionalProperties": false
}
