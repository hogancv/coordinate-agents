{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hogancv/coordinate-agents/schemas/task-graph-v1-plan.schema.json",
  "title": "Coordinate Agents Task Graph v1 scheduling plan",
  "type": "object",
  "required": ["schemaVersion", "deterministic", "sideEffects", "maxConcurrency", "runningCount", "availableSlots", "eligible", "capacityLimited", "conflictDeferred", "conflicts", "wave", "decisions", "intentCoverage", "preflight"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deterministic": { "const": true },
    "sideEffects": { "const": false },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
    "runningCount": { "type": "integer", "minimum": 0 },
    "availableSlots": { "type": "integer", "minimum": 0 },
    "eligible": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "capacityLimited": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "conflictDeferred": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "conflicts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/conflict" } },
    "wave": { "$ref": "#/$defs/wave" },
    "decisions": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/decision" } },
    "intentCoverage": { "$ref": "#/$defs/intentCoverage" },
    "preflight": { "$ref": "#/$defs/preflight" }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": ["id", "state"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "state": { "type": "string", "enum": ["PENDING", "READY", "WAITING", "RUNNING", "SUCCEEDED", "FAILED", "BLOCKED", "STOPPED"] }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["id", "registered", "adapter", "adapterContractVersion", "adapterCapabilities", "command", "commandSource", "argsSource"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "registered": { "const": true },
        "adapter": { "type": "string", "minLength": 1 },
        "adapterContractVersion": { "type": ["string", "null"] },
        "adapterCapabilities": { "type": ["object", "null"] },
        "command": { "type": "string", "minLength": 1 },
        "commandSource": { "type": "string", "enum": ["project", "user", "adapter-default"] },
        "argsSource": { "type": ["string", "null"], "enum": ["project", "user", null] }
      },
      "additionalProperties": false
    },
    "intentCoverage": {
      "type": "object",
      "required": ["available", "schemaVersion", "scopePolicy", "subtasks"],
      "properties": {
        "available": { "type": "boolean" },
        "schemaVersion": { "type": ["integer", "null"], "enum": [1, null] },
        "scopePolicy": { "type": ["string", "null"], "enum": ["observe", "warn", "strict", null] },
        "subtasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["subtaskId", "coverage", "writeIntent"],
            "properties": {
              "subtaskId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "coverage": { "type": "string", "enum": ["unavailable", "explicit-empty", "declared"] },
              "writeIntent": {
                "anyOf": [
                  { "type": "null" },
                  { "type": "array", "items": { "type": "string", "minLength": 1 } }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "required": ["schemaVersion", "deterministic", "sideEffects", "scopePolicy", "concurrentWriteSafety", "estimates", "risks", "boundaries"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "deterministic": { "const": true },
        "sideEffects": { "const": false },
        "scopePolicy": { "type": ["string", "null"], "enum": ["observe", "warn", "strict", null] },
        "concurrentWriteSafety": { "type": "string", "enum": ["DECLARED_NON_CONFLICTING", "UNVERIFIED"] },
        "estimates": {
          "type": "object",
          "required": ["basis", "selectedSubtaskCount", "worktreeCount", "branchCount", "busMessageCount", "sessionCount", "processCount"],
          "properties": {
            "basis": { "const": "current-selected-wave" },
            "selectedSubtaskCount": { "type": "integer", "minimum": 0, "maximum": 32 },
            "worktreeCount": { "type": "integer", "minimum": 0, "maximum": 32 },
            "branchCount": { "type": "integer", "minimum": 0, "maximum": 32 },
            "busMessageCount": { "type": "integer", "minimum": 0, "maximum": 32 },
            "sessionCount": { "type": "integer", "minimum": 0, "maximum": 32 },
            "processCount": { "type": "integer", "minimum": 0, "maximum": 32 }
          },
          "additionalProperties": false
        },
        "risks": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["code", "severity", "affectedSubtasks", "message"],
            "properties": {
              "code": { "type": "string", "enum": ["INTENT_COVERAGE_UNAVAILABLE", "WRITE_INTENT_CONFLICT", "CAPACITY_LIMITED"] },
              "severity": { "type": "string", "enum": ["info", "warning"] },
              "affectedSubtasks": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } },
              "message": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "additionalProperties": false
          }
        },
        "boundaries": {
          "type": "object",
          "required": ["changesDependencies", "dispatchesAgents", "authorizesReview", "authorizesRelease", "requiresExplicitGraphRun", "releaseApproval"],
          "properties": {
            "changesDependencies": { "const": false },
            "dispatchesAgents": { "const": false },
            "authorizesReview": { "const": false },
            "authorizesRelease": { "const": false },
            "requiresExplicitGraphRun": { "const": true },
            "releaseApproval": { "const": "RELEASE_APPROVED" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "required": ["code", "subtasks", "patterns", "conservative"],
      "properties": {
        "code": { "const": "WRITE_INTENT_CONFLICT" },
        "subtasks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
        },
        "patterns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["subtaskId", "pattern"],
            "properties": {
              "subtaskId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "pattern": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "additionalProperties": false
          }
        },
        "conservative": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "wave": {
      "type": "object",
      "required": ["schemaVersion", "deterministic", "intentCoverageAvailable", "selected", "conflictDeferred", "capacityLimited", "conflicts", "reasons"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "deterministic": { "const": true },
        "intentCoverageAvailable": { "type": "boolean" },
        "selected": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } },
        "conflictDeferred": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string" } },
        "capacityLimited": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string" } },
        "conflicts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/conflict" } },
        "reasons": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 2048 } }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["subtaskId", "implementer", "state", "decision", "reason", "dependencies", "agent"],
      "properties": {
        "subtaskId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "implementer": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "state": { "type": "string", "enum": ["PENDING", "READY", "WAITING", "RUNNING", "SUCCEEDED", "FAILED", "BLOCKED", "STOPPED"] },
        "decision": { "type": "string", "enum": ["ELIGIBLE", "CAPACITY_LIMITED", "WRITE_INTENT_CONFLICT", "PENDING", "READY", "WAITING", "RUNNING", "SUCCEEDED", "FAILED", "BLOCKED", "STOPPED"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "agent": { "$ref": "#/$defs/agent" },
        "conflict": { "$ref": "#/$defs/conflict" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
